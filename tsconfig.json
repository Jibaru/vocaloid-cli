{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "bun"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "tonal": ["./node_modules/tonal/dist/index.d.mts"]
    }
  },
  "include": ["src", "test"]
}
